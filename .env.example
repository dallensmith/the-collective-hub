# ── Database (Shared across all deployments) ─────────────────────
DATABASE_URL=

# ── Site Identity (Per-deployment) ────────────────────────────────
SITE_SLUG=local-dev
PUBLIC_SITE_URL=http://localhost:5173

# ── Auth — Better Auth (Shared secret; per-site base URL) ─────────
# Generate a real secret for production: openssl rand -base64 32
BETTER_AUTH_SECRET=better-auth-dev-secret-change-in-production
BETTER_AUTH_URL=http://localhost:5173

# ── Auth — Discord OAuth (Shared across all deployments) ──────────
# Get these from https://discord.com/developers/applications → your app → OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=

# ── Ownership Bootstrap (Per-deployment) ──────────────────────────
# Set this to your Discord user ID to become the site owner on first login.
OWNER_DISCORD_ID=

# ── Super Admin (Shared across all deployments) ───────────────────
# Comma-separated Discord user IDs with cross-site super admin access.
SUPER_ADMIN_DISCORD_IDS=

# ── Migration Control (Per-deployment) ────────────────────────────
# Only ONE deployment should have this set to "true".
RUN_MIGRATIONS=false

# ── Discord Bot (Shared across all deployments) ───────────────────
# Bot token from Discord Developer Portal → your application → Bot.
# Used to fetch scheduled events for Discord integration (Phase 6).
DISCORD_BOT_TOKEN=

# ── Bunny CDN (Shared across all deployments) ─────────────────────
# Public CDN hostname — the Pull Zone URL customers use to access files.
# Find this in Bunny dashboard → Pull Zones → your zone → Hostname.
CDN_BASE_URL=

# Storage API endpoint. Replace "ny" with your storage zone's region:
#   ny = New York, la = Los Angeles, sg = Singapore, uk = London, se = Stockholm
# Find this in Bunny dashboard → Storage → your storage zone → FTP & API Access.
CDN_STORAGE_ENDPOINT=
# Storage zone password. Find in Bunny dashboard → Storage →
# your storage zone → FTP & API Access → Read/Write password.
CDN_ACCESS_KEY=

# Storage zone name (used to construct upload paths).
CDN_BUCKET=

# ── Optional ──────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug
