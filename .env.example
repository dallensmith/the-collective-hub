# Drizzle
DATABASE_URL=postgres://root:mysecretpassword@localhost:5432/local

ORIGIN=

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# ── Auth — Discord OAuth (Shared across all deployments) ──────────
# Get these from https://discord.com/developers/applications → your app → OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

DISCORD_BOT_TOKEN=

# ── Ownership Bootstrap (Per-deployment) ──────────────────────────
# Set this to your Discord user ID to become the site owner on first login.
OWNER_DISCORD_ID=
